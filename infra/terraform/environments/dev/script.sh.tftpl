
#!/bin/bash

set -euo pipefail

# ============================================================
# Ubuntu 24.04 LTS
# EKS Worker Node + eBPF Development Environment
# ============================================================

exec > >(tee -a /var/log/eks-bootstrap.log) 2>&1

export DEBIAN_FRONTEND=noninteractive

echo "[START] EKS Worker Node Bootstrap"

# ============================================================
# 1. OS 및 Kernel 정보 확인
# ============================================================

echo "[INFO] Operating System"
cat /etc/os-release

echo "[INFO] Kernel Version"
uname -r

echo "[INFO] CPU Architecture"
uname -m

# ============================================================
# 2. eBPF Kernel BTF 확인
# ============================================================

echo "[CHECK] Kernel BTF"

if [ -r /sys/kernel/btf/vmlinux ]; then
    ls -lh /sys/kernel/btf/vmlinux
    echo "[OK] Kernel BTF available"
else
    echo "[WARNING] Kernel BTF unavailable"
fi

# ============================================================
# 3. Kernel BPF 설정 확인
# ============================================================

echo "[CHECK] Kernel BPF Configuration"

KERNEL_CONFIG="/boot/config-$(uname -r)"

if [ -r "$KERNEL_CONFIG" ]; then
    grep -E '^CONFIG_(BPF|BPF_SYSCALL|BPF_JIT|DEBUG_INFO_BTF|CGROUP_BPF|BPF_EVENTS|KPROBES|UPROBES)=' \
        "$KERNEL_CONFIG" || true
else
    echo "[WARNING] Kernel configuration file unavailable"
fi

# ============================================================
# 4. BPF Filesystem 확인 및 마운트
# ============================================================

echo "[CHECK] BPF Filesystem"

mkdir -p /sys/fs/bpf

if [ "$(findmnt -n -o FSTYPE --mountpoint /sys/fs/bpf || true)" = "bpf" ]; then
    echo "[OK] BPF filesystem already mounted"
else
    if mountpoint -q /sys/fs/bpf; then
        echo "[WARNING] Unexpected filesystem at /sys/fs/bpf"
    elif mount -t bpf bpffs /sys/fs/bpf; then
        echo "[OK] BPF filesystem mounted"
    else
        echo "[WARNING] BPF filesystem mount failed"
    fi
fi

findmnt -t bpf || true

# ============================================================
# 5. Cgroup 버전 확인
# ============================================================

echo "[CHECK] Cgroup Version"

CGROUP_TYPE=$(stat -fc %T /sys/fs/cgroup)

if [ "$CGROUP_TYPE" = "cgroup2fs" ]; then
    echo "[OK] Cgroup v2 enabled"
else
    echo "[WARNING] Cgroup type: $CGROUP_TYPE"
fi

# ============================================================
# 6. EKS Bootstrap 파일 확인
# ============================================================

if [ ! -x /etc/eks/bootstrap.sh ]; then
    echo "[ERROR] EKS bootstrap script not found"
    exit 1
fi

# ============================================================
# 7. EKS Worker Node 등록
# ============================================================

echo "[START] Registering EKS Worker Node"

/etc/eks/bootstrap.sh "${cluster_name}" \
    --apiserver-endpoint "${cluster_endpoint}" \
    --b64-cluster-ca "${cluster_ca}"

echo "[OK] EKS bootstrap command completed"

# ============================================================
# 8. Container Runtime 및 Kubelet 확인
# ============================================================

echo "[CHECK] Container Runtime"

systemctl status containerd --no-pager || true

echo "[CHECK] Kubelet"

systemctl status kubelet --no-pager || true

# ============================================================
# 9. eBPF 분석 도구 설치
# ============================================================

echo "[START] Installing eBPF development tools"

if apt-get -o Acquire::Retries=3 update; then

    PACKAGES=(
        bpftool
        bpftrace
        clang
        llvm
        libbpf-dev
        tcpdump
        strace
        build-essential
        pkg-config
        jq
    )

    for PACKAGE in "$${PACKAGES[@]}"; do
        echo "[INSTALL] $PACKAGE"

        if apt-get -o Acquire::Retries=3 install -y "$PACKAGE"; then
            echo "[OK] $PACKAGE installed"
        else
            echo "[WARNING] Failed to install $PACKAGE"
        fi
    done

else
    echo "[WARNING] APT repository update failed"
fi

# ============================================================
# 10. bpftool 설치 확인 및 대체 패키지
# ============================================================

if ! command -v bpftool >/dev/null 2>&1; then
    echo "[INFO] Trying kernel-specific Linux tools"

    apt-get install -y \
        linux-tools-common \
        "linux-tools-$(uname -r)" || true
fi

# ============================================================
# 11. eBPF Feature Probe
# ============================================================

REPORT_DIR="/var/log/ebpf"

mkdir -p "$REPORT_DIR"
chmod 700 "$REPORT_DIR"

if command -v bpftool >/dev/null 2>&1; then

    echo "[CHECK] eBPF Kernel Features"

    bpftool feature probe kernel \
        > "$REPORT_DIR/features.log" 2>&1 || true

    echo "[CHECK] Loaded BPF Programs"

    bpftool prog show \
        > "$REPORT_DIR/programs.log" 2>&1 || true

    echo "[CHECK] BPF Maps"

    bpftool map show \
        > "$REPORT_DIR/maps.log" 2>&1 || true

    echo "[CHECK] Network BPF Attachments"

    bpftool net show \
        > "$REPORT_DIR/network.log" 2>&1 || true

else
    echo "[WARNING] bpftool unavailable"
fi

# ============================================================
# 12. 설치 도구 버전 확인
# ============================================================

echo "[CHECK] Tool Versions"

bpftool version || true

bpftrace --version || true

clang --version || true

llvm-config --version || true

tcpdump --version || true

strace --version || true

# ============================================================
# 13. 초기화 결과
# ============================================================

echo "[INFO] eBPF Reports: $REPORT_DIR"

echo "[SUCCESS] Node initialization script completed"

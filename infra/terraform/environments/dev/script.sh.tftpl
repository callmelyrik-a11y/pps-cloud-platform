#!/bin/bash
set -euo pipefail

exec > >(tee -a /var/log/g2b-bootstrap.log) 2>&1

echo "[START] EC2 bootstrap"

# -----------------------------------------
# 1. Hostname and root password
# -----------------------------------------
hostnamectl --static set-hostname MyWeb

usermod --password '${ec2_root_password_hash}' root

# -----------------------------------------
# 2. Install packages
# -----------------------------------------
yum install -y \
  httpd \
  mariadb-server \
  mariadb \
  php \
  php-mysqlnd \
  php-gd \
  wget \
  unzip \
  curl \
  awscli

systemctl enable --now mariadb
systemctl enable --now httpd

php -m | grep -qi mysqli

echo "[OK] Packages installed"

# -----------------------------------------
# 3. Download bWAPP
# -----------------------------------------
wget -q -O /tmp/bWAPP.zip \
  https://github.com/ncs10322/aws/raw/main/bWAPP.zip

mkdir -p /tmp/bwapp-install

unzip -oq /tmp/bWAPP.zip -d /tmp/bwapp-install

cp -a /tmp/bwapp-install/bWAPP/. /var/www/html/

test -f /var/www/html/install.php
test -f /var/www/html/admin/settings.php

echo "[OK] bWAPP files installed"

# -----------------------------------------
# 4. Create MariaDB user
# Do not pre-create the bWAPP database.
# -----------------------------------------
mysql -u root <<'SQL'
GRANT ALL PRIVILEGES ON bWAPP.*
TO 'bwapp'@'localhost'
IDENTIFIED BY 'bug';

FLUSH PRIVILEGES;
SQL

echo "[OK] MariaDB user created"

# -----------------------------------------
# 5. Configure bWAPP DB connection
# -----------------------------------------
sed -i \
  's/\$db_username = "root"/\$db_username = "bwapp"/' \
  /var/www/html/admin/settings.php

# The original bWAPP setting uses password "bug".
grep -q 'db_username = "bwapp"' \
  /var/www/html/admin/settings.php

grep -q 'db_password = "bug"' \
  /var/www/html/admin/settings.php

# -----------------------------------------
# 6. Permissions
# -----------------------------------------
chown -R apache:apache /var/www/html

find /var/www/html -type d -exec chmod 755 {} \;
find /var/www/html -type f -exec chmod 644 {} \;

for dir in passwords images documents; do
  if [ -d "/var/www/html/$dir" ]; then
    chmod 770 "/var/www/html/$dir"
  fi
done

# -----------------------------------------
# 7. Initialize bWAPP tables automatically
# -----------------------------------------
echo "[START] bWAPP database initialization"

curl --fail --silent --show-error \
  "http://127.0.0.1/install.php?install=yes" \
  -o /tmp/bwapp-install-result.html

grep -q "bWAPP has been installed successfully" \
  /tmp/bwapp-install-result.html

# Verify database and tables
TABLE_COUNT=$(MYSQL_PWD=bug mysql \
  -u bwapp \
  -N -B \
  -e "SELECT COUNT(*)
      FROM information_schema.tables
      WHERE table_schema = 'bWAPP';")

test "$TABLE_COUNT" -gt 0

echo "[OK] bWAPP initialized: $TABLE_COUNT tables"

# -----------------------------------------
# 8. Set MariaDB root password
# Lab environment only
# -----------------------------------------
mysql -u root -e \
  "SET PASSWORD FOR 'root'@'localhost' =
   PASSWORD('toor');"

echo "[OK] MariaDB root password configured"

# -----------------------------------------
# 9. Download main.php from S3
# -----------------------------------------
aws s3 cp \
  s3://g2b-konep-513329232596-ap-northeast-2-an/main.php \
  /var/www/html/main.php

test -s /var/www/html/main.php

# -----------------------------------------
# 10. Apache default page
# -----------------------------------------
cat > /etc/httpd/conf.d/00-main-page.conf <<'EOF'
DirectoryIndex main.php index.php index.html
EOF

chown apache:apache /var/www/html/main.php
chmod 644 /var/www/html/main.php

php -l /var/www/html/main.php
httpd -t

systemctl restart httpd

# -----------------------------------------
# 11. Final verification
# -----------------------------------------
systemctl is-active --quiet httpd
systemctl is-active --quiet mariadb

curl --fail --silent --show-error \
  http://127.0.0.1/login.php \
  -o /tmp/bwapp-login-check.html

echo "[SUCCESS] EC2 bootstrap completed"

# Copy this to terraform.tfvars locally. Do not commit terraform.tfvars.
region                  = "ap-northeast-2"
project                 = "pps"
environment             = "dev"
vpc_cidr                = "10.20.0.0/16"
availability_zones       = ["ap-northeast-2a", "ap-northeast-2b"]
frontend_bucket_name    = "pps-dev-frontend-REPLACE-WITH-ACCOUNT-ID"
cluster_version         = "1.34"
node_instance_type      = "t3.medium"
node_min_size           = 2
node_desired_size       = 2
node_max_size           = 4
aurora_engine_version   = "8.0.mysql_aurora.3.10.3"
aurora_min_acu          = 0.5
aurora_max_acu          = 2.0
# eks_admin_principal_arn = "arn:aws:iam::ACCOUNT_ID:role/YourAdminRole"
# cluster_public_access_cidrs = ["YOUR_PUBLIC_IP/32"]
# alarm_email = "you@example.com"
# alb_controller_policy_arn = "arn:aws:iam::ACCOUNT_ID:policy/AWSLoadBalancerControllerIAMPolicy"

# public_domain_name = "www.YOUR-OWNED-DOMAIN.example"
# hosted_zone_id = "Z0123456789EXAMPLE"
